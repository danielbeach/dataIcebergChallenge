# Published read-only Drive Stats credentials from Backblaze's Drive Stats page:
# https://www.backblaze.com/cloud-storage/resources/hard-drive-test-data
# Copy this file to .env and fill in the two values. Never commit .env.
DRIVESTATS_S3_ACCESS_KEY_ID=
DRIVESTATS_S3_SECRET_ACCESS_KEY=

# Optional overrides; the defaults below match the public table.
DRIVESTATS_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
DRIVESTATS_S3_REGION=us-west-004
